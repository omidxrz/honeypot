# The Names this sensor publishes. Single source of truth.
#
# ops/deploy.sh generates etc/nginx-hostmap.conf from this file; ops/rollup.py
# parses it at runtime. Nothing else may hardcode a Name.
#
# This is a template. The real etc/names.env carries the live Bait Name and
# host address, is gitignored, and never leaves this machine and the box --
# same treatment as credentials.json and bait/. Copy this file to
# etc/names.env and fill in the real values; deploy.sh reads that file, not
# this one.
#
# Retiring a Bait Name means moving it to CONTROL_NAMES, never deleting it: the
# Certificate Transparency entry is permanent and the traffic keeps arriving.

# Currently resolves here, and is in a certificate.
BAIT_NAMES="ops.example.com"

# Retired Bait Names: no longer resolve, still counted as Contacts. An Actor
# still asking for one is working from historical passive DNS or a CT mirror,
# which is worth telling apart from one resolving the live Name. Space-separated.
CONTROL_NAMES=""

# This host's address. Used to recognise Derived Names.
HOST_ADDR="203.0.113.1"

# Where the sensor itself sits on the map. Left unset, it is looked up from
# HOST_ADDR in the geo table -- which for a datacenter address often gives the
# registrant's country rather than the rack. Set both to override.
#HOST_LAT="51.0834"
#HOST_LON="10.4234"
